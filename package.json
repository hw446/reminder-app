{
  "name": "reminder-app",
  "version": "1.0.2",
  "description": "Fullscreen reminder assistant for macOS",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.reminder.app",
    "productName": "Reminder Assistant",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "darkModeSupport": true
    },
    "dmg": {
      "title": "Reminder Assistant",
      "background": "assets/dmg-bg.png",
      "window": { "width": 540, "height": 380 }
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  }
}
